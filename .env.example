# ─────────────────────────────────────────────────────────────
#  Cadence Coach — environment template
#  Copy to .env and fill in what you have. Only GROQ_API_KEY and
#  AZURE_SPEECH_KEY are required.
#
#  Put each value right after the '='. Keep comments on their OWN
#  line — never after an empty value (an empty KEY=   # note line
#  can be read as the value "# note").
# ─────────────────────────────────────────────────────────────

# ── Required ──
# LLM + Whisper STT (console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Neural TTS (Azure portal → Speech resource → Keys and Endpoint)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia

# ── LLM tuning (optional) ──
# Groq retires models; /api/health → llm.available tells you if this one still exists.
LLM_MODEL=qwen/qwen3.8-27b
# Whisper model for the Coach's audio mode (large-v3 hears fillers best; -turbo is faster)
WHISPER_MODEL=whisper-large-v3

# ── Azure TTS tuning (optional) ──
# Pre-warmed synthesizers = how many script segments the Director synthesises in parallel
TTS_POOL_SIZE=3
# Delete generated MP3s older than this at boot
AUDIO_RETENTION_HOURS=24

# ── Google OAuth (optional — app runs in guest mode without it) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET_KEY=change_me_to_a_long_random_string
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── Database ──
# auto = try MySQL then fall back to SQLite; sqlite = zero-infra local mode
DB_BACKEND=auto
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cadence_coach

# ── Rate limiting ──
RATE_LIMIT_TOKENS_PER_HOUR=100000
RATE_LIMIT_WINDOW_SECONDS=3600
